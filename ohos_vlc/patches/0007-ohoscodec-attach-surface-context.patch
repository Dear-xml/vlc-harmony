+/* Pace surface presents in the decoder thread.
+ * Stamping many frames into the future holds OHOS output buffers until the
+ * timestamp (RenderOutputBufferAtTime note 1), so the 4K HEVC pool starves
+ * and then bursts — which the composer drops (note 3). Sleep until the next
+ * slot, then present near "now" so only ~1 buffer is in flight. */
+static int64_t ohos_now_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+
+static int64_t ohos_surface_timestamp_ns(decoder_t *p_dec, decoder_sys_t *p_sys)
+{
+    if (p_sys->ohos_frame_period_ns <= 0)
+    {
+        unsigned num = p_dec->fmt_in.video.i_frame_rate;
+        unsigned den = p_dec->fmt_in.video.i_frame_rate_base;
+        int64_t period = 16666666LL;
+        if (num > 0 && den > 0)
+            period = (int64_t)den * 1000000000LL / num;
+        /* 60000/1 etc. is a tick rate, not 60 fps. */
+        if (period < 8000000LL || period > 42000000LL)
+            period = 16666666LL;
+        p_sys->ohos_frame_period_ns = period;
+        msg_Err(p_dec, "OHOS surface pace %lld ns (rate %u/%u)",
+                (long long)period, num, den);
+    }
+
+    int64_t period = p_sys->ohos_frame_period_ns;
+    int64_t now = ohos_now_ns();
+
+    if (p_sys->ohos_next_ts > now)
+    {
+        int64_t delay = p_sys->ohos_next_ts - now;
+        if (delay > period)
+            delay = period;
+        struct timespec slp = { .tv_sec = 0, .tv_nsec = (long)delay };
+        nanosleep(&slp, NULL);
+        now = ohos_now_ns();
+    }
+
+    p_sys->ohos_next_ts = now + period;
+    p_sys->ohos_present_count++;
+    if (p_sys->ohos_present_window_start == 0)
+        p_sys->ohos_present_window_start = now;
+    else if (now - p_sys->ohos_present_window_start >= 1000000000LL)
+    {
+        msg_Err(p_dec, "OHOS present %d fps (target 60, period %lld ns)",
+                p_sys->ohos_present_count, (long long)period);
+        p_sys->ohos_present_count = 0;
+        p_sys->ohos_present_window_start = now;
+    }
+    return now;
+}
 #endif
 
